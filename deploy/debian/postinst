#!/bin/sh
# n5-fangov postinst: reload systemd, enable the unit, install the PVE
# templates and the apt kernel-gate hook. Never starts the daemon on a fresh
# install (run `n5-fangov setup` first); on upgrade a running daemon is
# restarted so the new binary takes over.
set -e

APT_HOOK=/etc/apt/apt.conf.d/90n5-fangov

case "$1" in
    configure)
        # The Bash predecessor must not regulate in parallel.
        if [ -f /etc/systemd/system/n5-fand.service ] || [ -f /lib/systemd/system/n5-fand.service ]; then
            if systemctl is-active --quiet n5-fand.service 2>/dev/null; then
                echo "n5-fangov: stopping n5-fand.service (predecessor); two regulators must never run at once"
                systemctl stop n5-fand.service || true
            fi
            if systemctl is-enabled --quiet n5-fand.service 2>/dev/null; then
                echo "n5-fangov: disabling n5-fand.service; remove it with minisforum-n5pro-fan-proxmox/legacy/uninstall.sh later"
                systemctl disable n5-fand.service || true
            fi
        fi
        # Best effort like install.sh: /etc/pve is pmxcfs and read-only
        # without quorum; a failed mkdir must not leave the package
        # half-configured (daemon-reload/enable below would be skipped).
        if [ -d /etc/pve ]; then
            if mkdir -p /etc/pve/notification-templates/default 2>/dev/null; then
                cp /usr/share/n5-fangov/pve-notification/n5-fangov-subject.txt.hbs /etc/pve/notification-templates/default/ 2>/dev/null || true
                cp /usr/share/n5-fangov/pve-notification/n5-fangov-body.txt.hbs    /etc/pve/notification-templates/default/ 2>/dev/null || true
            else
                echo "n5-fangov: /etc/pve/notification-templates not writable (no quorum?); install the template later: n5-fangov alerts template"
            fi
        fi
        mkdir -p /etc/n5-fangov/presets
        mkdir -p /var/log/n5-fangov
        chmod 0750 /var/log/n5-fangov || true
        if [ -d /etc/apt/apt.conf.d ]; then
            cp /usr/share/n5-fangov/apt-90n5-fangov.conf "$APT_HOOK"
            chmod 0644 "$APT_HOOK"
        fi
        # install.sh puts the units under /etc/systemd/system, where they would
        # shadow the packaged ones on every later update and survive apt remove.
        # An identical copy is the installer's and goes; a differing one is the
        # operator's and stays (named, so it can be looked at). Drop-ins under
        # n5-fangov.service.d/ are never touched.
        relink=0
        for u in n5-fangov.service n5-fangov-onfailure.service; do
            if [ -f "/etc/systemd/system/$u" ]; then
                if cmp -s "/etc/systemd/system/$u" "/lib/systemd/system/$u"; then
                    rm -f "/etc/systemd/system/$u"
                    relink=1
                    echo "n5-fangov: removed /etc/systemd/system/$u (installer copy, identical to the packaged unit)"
                else
                    echo "n5-fangov: WARNING /etc/systemd/system/$u differs from the packaged unit and shadows it; compare with systemctl cat $u and remove it if it is not yours"
                fi
            fi
        done
        systemctl daemon-reload || true
        if [ "$relink" = 1 ]; then
            # the installer's enable symlink pointed at the removed copy
            systemctl reenable n5-fangov.service || true
        else
            systemctl enable n5-fangov.service || true
        fi
        # A running daemon still executes the previous binary (dpkg replaced the
        # file on disk): restart it on a package upgrade and equally on the first
        # package install over a running install.sh deployment.
        if systemctl is-active --quiet n5-fangov.service 2>/dev/null; then
            echo "n5-fangov: daemon is running (${2:-installer deployment}), restarting it so the new binary takes over"
            systemctl restart n5-fangov.service || true
        elif [ -f /etc/n5-fangov/config.toml ]; then
            echo "n5-fangov: installed and enabled. Next: n5-fangov check && systemctl start n5-fangov"
        else
            echo "n5-fangov: installed and enabled. Next: n5-fangov setup"
        fi
        ;;
esac
exit 0
