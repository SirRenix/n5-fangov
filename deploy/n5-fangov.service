[Unit]
Description=n5-fangov guarded fan control (Proxmox VE / Debian)
Documentation=https://github.com/SirRenix/n5-fangov
After=systemd-modules-load.service
# n5-fand is the predecessor; both must never regulate at the same time
Conflicts=n5-fand.service
# After 5 failed starts within 5 min the unit stays "failed" -> OnFailure alerts
StartLimitIntervalSec=300
StartLimitBurst=5
OnFailure=n5-fangov-onfailure.service

[Service]
Type=notify
NotifyAccess=main
# Self-check fails LOUDLY when config/profile/sysfs are not usable
ExecStartPre=/usr/bin/n5-fangov check --quiet
ExecStart=/usr/bin/n5-fangov serve
# Runs after EVERY end, also after SIGKILL, watchdog kill or crash
ExecStopPost=/usr/bin/n5-fangov failsafe
# The daemon sends WATCHDOG=1 every cycle (interval 2..30 s) and every 10 s from a
# ticker while the loop is alive (last cycle within 3x interval); a hung loop is restarted
WatchdogSec=60
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20
Nice=-5

# --- directories ---------------------------------------------------------
# /run/n5-fangov holds the unauthenticated CLI socket: root only (M3)
RuntimeDirectory=n5-fangov
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
# /var/log/n5-fangov: rotating log file ([log].file); journal stays primary
LogsDirectory=n5-fangov
LogsDirectoryMode=0750
# /var/lib/n5-fangov: sessions.json (dashboard "remember me" cookies) and
# alerts.json (recent alert history); root only, the session tokens are secrets
StateDirectory=n5-fangov
StateDirectoryMode=0700
UMask=0077

# --- sandbox (DESIGN v0.2; verify on the real box after every change) ----
# The daemon writes pwmN/pwmN_enable under /sys: ProtectKernelTunables MUST
# stay "no" and /sys/class/hwmon + /sys/devices MUST be in ReadWritePaths.
# `make verify-deploy` runs systemd-analyze verify over this file.
NoNewPrivileges=yes
ProtectSystem=strict
# "-" = do not fail the start when the path is absent (L7). The postfix
# maildrop is for the mail(1)/sendmail alert path on non-PVE hosts (H4);
# PVE::Notify with an SMTP target needs no extra path. NOTE: that mail path
# also needs CAP_DAC_OVERRIDE (maildrop is 0730 postfix:postdrop and
# NoNewPrivileges suppresses postdrop's setgid) — see README "Hardening".
# /etc/pve/notification-templates: the dashboard's "install template" button
# writes the two n5-fangov .hbs files there (pmxcfs; verified on the reference
# host: a process under this sandbox creates and removes a file in that
# directory). The directory itself must exist — a fresh box gets it from
# install.sh or `n5-fangov alerts template` (both run outside the sandbox).
ReadWritePaths=-/etc/n5-fangov -/run/n5-fangov -/var/log/n5-fangov -/var/lib/n5-fangov -/sys/class/hwmon -/sys/devices -/var/spool/postfix/maildrop -/etc/pve/notification-templates
ProtectHome=yes
PrivateTmp=yes
# /dev holds only the pseudo devices; [log].file must be under /var/log
# anyway, and nothing here needs a block or character device (H2)
PrivateDevices=yes
ProtectKernelTunables=no
ProtectControlGroups=yes
# AF_NETLINK: net.Interfaces() (the fallback for the TLS certificate's
# address list) reads the interface table over netlink (H3)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Cost-free directives that back the empty capability set up (the daemon
# runs as uid 0 without capabilities; these keep a code-execution bug in
# the web handler from reaching what the capabilities would have guarded):
# no module load/unload, no kernel log ring, no clock or hostname change,
# no SUID/SGID files, other processes' /proc entries hidden. ProcSubset is
# NOT set: sysinfo reads /proc/cpuinfo, meminfo, uptime, loadavg and
# /proc/sys/kernel/osrelease.
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
ProtectProc=invisible
# The daemon runs as root but needs no capability (M2): sysfs attributes
# are writable for uid 0 without CAP_DAC_OVERRIDE, the files it writes are
# its own, and the kernel module is loaded by modules-load.d, never from
# here (check --after-update only looks at files under /lib/modules).
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
