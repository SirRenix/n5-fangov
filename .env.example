# n5-fangov — environment variables (copy to .env for local use; .env is git-ignored).
#
# The daemon takes NO secrets from the environment: the dashboard password is set
# with `n5-fangov setup` / `n5-fangov passwd` (--password-file or stdin) and stored
# as a PBKDF2 hash in /etc/n5-fangov/config.toml (0600). Nothing below is sensitive.

# Runtime directory (socket, state.json, override/alert stamps). Default: /run/n5-fangov
N5FANGOV_RUN_DIR=/run/n5-fangov

# State directory (sessions.json, alerts.json). Default: $STATE_DIRECTORY, else /var/lib/n5-fangov
N5FANGOV_STATE_DIR=/var/lib/n5-fangov

# sysfs root — only for tests and dry runs against a fake tree. Default: /sys
#N5FANGOV_SYSFS=./testdata/sysfs/n5pro

# Build helper (tools/remote-go.ps1): ssh alias of a Linux host with Docker.
# The alias lives in your ~/.ssh/config; put a placeholder here, never a real address.
N5FANGOV_BUILD_HOST=builder
